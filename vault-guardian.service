[Unit]
Description=Vault Guardian - USB-gated encrypted folder
After=graphical-session.target
PartOf=graphical-session.target
# Don't restart-storm if the tray backend is missing; USB monitor stays up
# once the process no longer exits on an empty DISPLAY.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Use the wrapper so DISPLAY/WAYLAND_DISPLAY can be inferred when systemd
# --user starts us with an empty environment (typical with linger).
ExecStart=%h/.local/bin/vault-guardian
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
